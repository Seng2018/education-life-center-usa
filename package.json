{
  "dependencies": {
    "@tanstack/react-query": "5.100.10",
    "drizzle-orm": "0.45.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "2.15.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "4.1.13",
    "tailwindcss-safe-area": "1.3.0",
    "typescript": "5.6.3",
    "vite": "^6.0.7",
    "wrangler": "^4.45.0"
  },
  "name": "education-life-center-usa",
  "private": true,
  "scripts": {
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply education-life-center-usa --local",
    "db:migrate:remote": "wrangler d1 migrations apply education-life-center-usa --remote",
    "db:seed:local": "wrangler d1 execute education-life-center-usa --local --file=db/seed-jobs.sql",
    "deploy": "npm run build && wrangler deploy",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}